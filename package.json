{
  "name": "content-lab",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stack.ps1",
    "dev:stack:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stack.ps1 -Worker",
    "dev:stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev-stack.ps1",
    "console:open": "powershell -NoProfile -File open-console.ps1",
    "console:open:docker": "powershell -NoProfile -File open-console.ps1 -DockerWeb",
    "console:stop": "powershell -NoProfile -File stop-console.ps1",
    "lint": "pnpm --filter web lint && pnpm --filter @content-lab/shared-ts lint",
    "format": "pnpm --filter web format && pnpm --filter @content-lab/shared-ts format",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @content-lab/shared-ts typecheck",
    "test": "pnpm --filter web test && pnpm --filter @content-lab/shared-ts test"
  }
}
