# Local worktree label (see git config contentlab.worktreeName)
.worktree-name

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local worktree label (optional; do not commit)
.cursor/worktree-name

# Node
node_modules/
.pnpm-store/
dist/
.next/
out/
coverage/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Logs / artifacts
*.log
.console-state.json
.console-*-build-fingerprint
outputs/

# Quick Reel local renders (MP4 + overlay render trace)
.quick-reel-renders/

# Seed script output. Old runs wrote a new timestamped folder (~50 MB) per run, e.g.
# artifacts/asset_packs/faceless_cooking_real_png/20261125-*/; seeds now reuse a download
# cache. (Three 202605* runs are still tracked; ignore rules do not affect tracked files.)
artifacts/asset_packs/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]/
artifacts/asset_packs/*/last_seed_summary.json
artifacts/seed_steakpagetest/downloads/
artifacts/seed-cache/
