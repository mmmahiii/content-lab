    "remotion": "4.0.539",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.539",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
