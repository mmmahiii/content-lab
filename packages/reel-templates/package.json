{
  "name": "@content-lab/reel-templates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./render/index.ts"
  },
  "scripts": {
    "studio": "remotion studio src/entry.ts --public-dir=../../artifacts/asset_packs/faceless_cooking_real_png/20260511-164911",
    "render:operations": "remotion render src/entry.ts OperationsBaseline out/operations-remotion.mp4",
    "render:ratatouille": "remotion render src/entry.ts RatatouilleAssets out/ratatouille-remotion.mp4 --public-dir=../../artifacts/asset_packs/faceless_cooking_real_png/20260511-164911",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "RENDER_INTEGRATION=1 vitest run render/renderQuickReel.integration.test.ts",
    "render:quick-reel": "remotion render src/entry.ts QuickReel out/quick-reel-punchy.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
