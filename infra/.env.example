# ── Content Laboratory — Environment Variables ───────────────────────
# Copy to repo root:  cp infra/.env.example .env  (never commit .env)
#
# Loaded by:
#   • Docker Compose  (infra/docker-compose.yml)
#   • Python shared settings  (packages/shared/py — pydantic-settings)
# ─────────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=contentlab
POSTGRES_PASSWORD=contentlab
POSTGRES_DB=contentlab

# SQLAlchemy async URL used by the API and worker (host port matches docker-compose postgres publish)
DATABASE_URL=postgresql+psycopg://contentlab:contentlab@localhost:5433/contentlab

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible object store) ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=content-lab

# ── External APIs (never commit real keys) ───────────────────────────
RUNWAY_API_KEY=changeme
# Use https://api.runwayml.com if your key is for production (default is Runway dev API).
# RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
# RUNWAY_API_VERSION=2024-11-06

# —— Web operator console ——————————————————————————————————————————————————————————————
# Optional: set an org UUID so policy, queue, and API-backed dashboard views load immediately.
CONTENT_LAB_OPERATOR_ORG_ID=

# —— LLM creative generation (packages/intelligence) ————————————————————————————————————
# Hooks, Quick Reel branches, idea plans and reel scripts. Leave empty to use the
# deterministic fallbacks (everything still works offline).
ANTHROPIC_API_KEY=
# CONTENT_LAB_LLM_MODEL=claude-sonnet-5-5
# CONTENT_LAB_LLM_EFFORT=medium            # low | medium | high | xhigh | max
# CONTENT_LAB_LLM_PROVIDER=anthropic       # set to "none" to disable LLM calls
# CONTENT_LAB_LLM_REFUSAL_FALLBACKS=1      # server-side refusal fallbacks on
# CONTENT_LAB_SCRIPT_GENERATOR=            # llm | rules_plus_provider | deterministic_stub
